    characterSetSelectionMode: 7
    characterSequence: "\u4E00\u3001 \u6838\u5FC3\u4F20\u7EDF\u6210\u54C1\uFF1A\u670D\u9970\u4E0E\u65E5\u7528\u5E03\u827A\u8FD9\u7C7B\u4EA7\u54C1\u6700\u76F4\u63A5\u5730\u4F53\u73B0\u4E86\u624E\u67D3\u7684\u5B9E\u7528\u529F\u80FD\uFF0C\u662F\u767D\u65CF\u4EBA\u6C11\u65E5\u5E38\u751F\u6D3B\u667A\u6167\u7684\u7ED3\u6676.1. 
      \u670D\u88C5\u7C7B:\u624E\u67D3\u8863\u670D\uFF08\u5973\u88C5\u3001\u7537\u88C5\uFF09\u3001\u56F4\u5DFE\u662F\u767D\u65CF\u4F20\u7EDF\u670D\u9970\u7684\u91CD\u8981\u7EC4\u6210\u90E8\u5206\u3002\u56FE\u6848\u591A\u91C7\u7528\u5BD3\u610F\u5409\u7965\u7684\u7EB9\u6837\uFF0C\u84DD\u767D\u4E8C\u8272\u4E0E\u767D\u65CF\"\u98CE\u82B1\u96EA\u6708\"\u7684\u5934\u9970\u76F8\u5F97\u76CA\u5F70\uFF0C\u4F53\u73B0\u4E86\u6C11\u65CF\u7684\u5BA1\u7F8E\u30022. 
      \u5BB6\u5C45\u5E03\u827A:\u5E8A\u5355\u3001\u62B1\u6795\u3001\u684C\u5E03\u3001\u95E8\u5E18\u8FC7\u53BB\u662F\u5973\u513F\u51FA\u5AC1\u65F6\u91CD\u8981\u7684\u5AC1\u5986.\u684C\u5E03\u548C\u95E8\u5E18\u662F\u767D\u65CF\u5BB6\u5EAD\u4E2D\u5E38\u89C1\u7684\u88C5\u9970\uFF0C\u4E3A\u5BB6\u5C45\u73AF\u5883\u589E\u6DFB\u4E86\u4E00\u4EFD\u6734\u7D20\u81EA\u7136\u7684\u6C14\u606F\u30023. 
      \u627F\u8F7D\u7269:\u80CC\u88AB\uFF08\u7528\u4E8E\u80CC\u5C0F\u5B69\u7684\u80CC\u5E26\uFF09\u6700\u5177\u60C5\u611F\u6E29\u5EA6\u7684\u624E\u67D3\u54C1\u3002\u901A\u5E38\u4E2D\u5FC3\u6709\u4E00\u5757\u5706\u5F62\u4E3B\u7EB9\uFF08\u5982\u516B\u5366\u3001\u8774\u8776\u3001\u82B1\u5349\uFF09\uFF0C\u5BD3\u610F\u5E87\u62A4\u5B69\u7AE5\u3001\u5409\u7965\u5B89\u5EB7\u3002\u505A\u5DE5\u6781\u5176\u7E41\u590D\u7CBE\u7EC6\uFF0C\u51DD\u805A\u4E86\u957F\u8F88\u5BF9\u5B69\u5B50\u7684\u7231\u4E0E\u795D\u798F\u3002\u4E8C\u3001
      \u73B0\u4EE3\u521B\u65B0\u4E0E\u884D\u751F\u4EA7\u54C1\u968F\u7740\u65C5\u6E38\u5E02\u573A\u548C\u975E\u9057\u521B\u65B0\u6D6A\u6F6E\uFF0C\u624E\u67D3\u7684\u5E94\u7528\u8303\u56F4\u88AB\u6781\u5927\u62D3\u5C55\uFF0C\u884D\u751F\u51FA\u4F17\u591A\u517C\u5177\u827A\u672F\u6027\u4E0E\u5B9E\u7528\u6027\u7684\u4EA7\u54C1\u30021. 
      \u65F6\u5C1A\u914D\u9970\u4E0E\u5305\u888B\uFF1A\u5404\u79CD\u6B3E\u5F0F\u7684\u5305\uFF08\u624B\u63D0\u5305\u3001\u5355\u80A9\u5305\u3001\u80CC\u5305\uFF09\u3001\u5E3D\u5B50\u3001\u53D1\u9970\u3001\u9970\u54C1\u3001\u5DE5\u827A\u54C1\u7B49\u3002\u8FD9\u7C7B\u4EA7\u54C1\u5C0F\u5DE7\u3001\u65F6\u5C1A\u3001\u6613\u643A\u5E26\uFF0C\u662F\u6E38\u5BA2\u6700\u559C\u6B22\u7684\u7EAA\u5FF5\u54C1\u3002\u8BBE\u8BA1\u5E08\u5C06\u4F20\u7EDF\u7EB9\u6837\u4E0E\u73B0\u4EE3\u7248\u578B\u7ED3\u5408\uFF0C\u8BA9\u975E\u9057\"\u6F6E\"\u8D77\u6765\uFF0C\u8D70\u5165\u4E86\u5E74\u8F7B\u4EBA\u7684\u65E5\u5E38\u751F\u6D3B\u30022. 
      \u5BB6\u5C45\u88C5\u9970\u4E0E\u827A\u672F\u54C1:\u88C5\u9970\u753B\u3001\u706F\u7F69\u3001\u676F\u57AB\u3001\u8FD9\u7C7B\u4EA7\u54C1\u7A81\u51FA\u4E86\u624E\u67D3\u7684\u827A\u672F\u88C5\u9970\u4EF7\u503C\uFF0C\u6EE1\u8DB3\u4E86\u73B0\u4EE3\u4EBA\u5BF9\u4E2A\u6027\u5316\u3001\u827A\u672F\u5316\u5BB6\u5C45\u73AF\u5883\u7684\u9700\u6C42\u30023.
