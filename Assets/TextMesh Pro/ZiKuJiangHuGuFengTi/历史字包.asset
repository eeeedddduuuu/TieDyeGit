    characterSetSelectionMode: 7
    characterSequence: "\u5386\u53F2\u65F6\u95F4\u8F74\u79E6\u6C49\u65F6\u671F\u516C\u5143\u5E74\u524D\u8D77\u6E90\u4E0E\u840C\u82BD\u624E\u67D3\u96CF\u5F62\u7EDE\u7F2C\u5DE5\u827A\u4E2D\u539F\u5730\u533A\u51FA\u73B0\u636E\u53F2\u6599\u8BB0\u8F7D\u59CB\u6709\u4E4B\u6B64\u65F6\u5DF2\u51FA\u73B0\u57FA\u672C\u9632\u67D3\u8272\u6280\u672F\u6838\u5FC3\u539F\u7406\u5373\u7EBF\u7F1D\u7EAB\u4EE5\u9632\u6B62\u5F62\u6210\u9B4F\u664B\u5357\u5317\u671D\u65E9\u671F\u53D1\u5C55\u4F20\u64AD\u6280\u672F\u8D8B\u4E8E\u6210\u719F\u5B9E\u7269\u8BC1\u636E\u5B58\u4E16\u4E1C\u664B\u5DF2\u6709\u67D3\u7F2C\u8272\u6CD5\u660E\u786E\u8BB0\u8F7D\u751F\u4EA7\u5927\u6279\u7EF8\u5317\u9B4F\u670D\u9970\u90FD\u57CE\u6D1B\u9633\u7B49\u5730\u6210\u4E3A\u5973\u6027\u65F6\u5C1A\u5510\u4EE3\u9F0E\u76DB\u5357\u4F20\u6280\u827A\u8FBE\u5230\u4ECE\u4E2D\u539F\u4F20\u5165\u5357\u8BCF\u4ECA\u5927\u7406\u5730\u533A\u7CBE\u6E5B\u7EB9\u6837\u534E\u4E3D\u7687\u5BA4\u8D21\u54C1\u6C11\u95F4\u6D41\u884C\u670D\u9970\u5E74\u821E\u961F\u8D74\u957F\u5B89\u732E\u827A\u821E\u8863\u5236\u6210\u5370\u8BC1\u4F20\u5165\u4E91\u5357\u88AB\u767D\u65CF\u5148\u6C11\u5438\u6536\u901A\u8FC7\u4E1D\u7EF8\u4E4B\u8DEF\u65E5\u672C\u7B49\u56FD\u6B63\u4ED3\u9662\u4FDD\u5B58\u73CD\u54C1\u5B8B\u4EE3\u4E2D\u539F\u5F0F\u5FAE\u8FB9\u5730\u5B58\u7EED\u56E0\u653F\u7B56\u9650\u5236\u8870\u843D\u4F46\u5728\u6301\u7EED\u53D1\u5C55\u5317\u5B8B\u4E2D\u5DDE\u867D\u4E00\u5EA6\u76DB\u884C\u6574\u4F53\u5F71\u54CD\u529B\u51CF\u5F31\u5728\u793E\u4F1A\u4E2D\u624E\u6839\u672C\u571F\u6587\u5316\u878D\u5408\u5F00\u59CB\u72EC\u7279\u98CE\u683C\u5E7F\u6CDB\u4F7F\u7528\u84DD\u8349\u690D\u7269\u67D3\u6599\u5960\u5B9A\u540E\u4E16\u84DD\u767D\u76F8\u95F4\u8272\u5F69\u57FA\u7840\u5143\u660E\u6E05\u5730\u65B9\u5316\u7E41\u8363\u5F62\u6210\u9C9C\u660E\u7279\u8272\u91CD\u8981\u4EA7\u4E1A\u51E0\u8FD1\u5931\u4F20\u5B8C\u6574\u4FDD\u5B58\u84EC\u52C3\u53D1\u5C55\u53E4\u4EE3\u6D3B\u5316\u77F3\u660E\u4EE3\u4E13\u4E1A\u67D3\u5E03\u884C\u4F1A\u6D31\u6D77\u536B\u7EA2\u5E03\u95FB\u540D\u9050\u8FE9\u6E05\u4EE3\u5468\u57CE\u559C\u6D32\u7B49\u5730\u4E2D\u5FC3\u559C\u6D32\u5E03\u5927\u7406\u5E03\u7545\u9500\u5404\u5730\u5BB6\u5BB6\u6709\u67D3\u7F38\u6237\u6237\u51FA\u624E\u67D3\u76DB\u51B5\u7531\u6B64\u5960\u5B9A\u8FD1\u73B0\u4EE3\u4F20\u627F\u4EA7\u4E1A\u5316\u73B0\u4EE3\u5316\u51B2\u51FB\u575A\u5B88\u5EFA\u7ACB\u5DE5\u5382\u8D70\u5411\u4E16\u754C\u4F20\u7EDF\u5BB6\u5EAD\u91CD\u8981\u7ECF\u6D4E\u526F\u4E1A\u5E74\u5EFA\u7ACB\u7B2C\u4E00\u5BB6\u5382\u5B9E\u73B0\u4EA7\u4E1A\u5316\u4EA7\u54C1\u8FDC\u9500\u65E5\u672C\u6B27\u7F8E\u7B49\u5730\u4F7F\u95FB\u540D\u4E16\u754C\u5F53\u4EE3\u975E\u9057\u4FDD\u62A4\u521B\u65B0\u5217\u5165\u56FD\u5BB6\u7EA7\u975E\u7269\u8D28\u6587\u5316\u9057\u4EA7\u8FCE\u6765\u65B0\u751F\u5E74\u7ECF\u56FD\u52A1\u9662\u6279\u51C6\u5217\u5165\u7B2C\u4E00\u6279\u540D\u5F55\u5F20\u4ED5\u7EC5\u6BB5\u94F6\u5F00\u7B49\u4EBA\u88AB\u8BA4\u5B9A\u4E3A\u56FD\u5BB6\u7EA7\u4EE3\u8868\u6027\u4F20\u627F\u4EBA\u5EFA\u7ACB\u535A\u7269\u9986\u6536\u96C6\u6574\u7406\u4F20\u7EDF\u7EB9\u6837\u6280\u827A\u65B0\u4E00\u4EE3\u521B\u7ACB\u84DD\u7EED\u54C1\u724C\u5C06\u4F20\u7EDF\u4E0E\u73B0\u4EE3\u8BBE\u8BA1\u76F8\u7ED3\u5408\u5F00\u53D1\u5F69\u8272\u65B0\u4EA7\u54C1\u8D70\u5411\u56FD\u9645\u65F6\u5C1A\u821E\u53F0\u5E74\u968F\u5929\u5BAB\u8BFE\u5802\u8FDB\u5165\u4E2D\u56FD\u7A7A\u95F4\u7AD9\u5B9E\u73B0\u4F20\u7EDF\u79D1\u6280\u8DE8\u65F6\u7A7A\u5BF9\u8BDD\u8BE6\u7EC6\u8D44\u6599\u8D77\u6E90\u65E9\u671F\u53D1\u5C55\u79E6\u6C49\u5357\u5317\u671D\u53E4\u79F0\u7EDE\u7F2C\u6211\u56FD\u53E4\u4EE3\u7EBA\u7EC7\u54C1\u67D3\u8272\u5DE5\u827A\u6770\u51FA\u4EE3\u8868\u5177\u6709\u60A0\u4E45\u4E30\u5BCC\u5386\u53F2\u6E0A\u6E90\u6839\u636E\u8FD9\u9879\u6280\u827A\u6700\u65E9\u53EF\u8FFD\u6EAF\u81F3\u5F53\u65F6\u5DF2\u7ECF\u51FA\u73B0\u4E86\u67D3\u7F2C\u8272\u6CD5\u516C\u5143\u5E74\u4E1C\u664B\u65F6\u671F\u4F5C\u54C1\u8BC1\u5B9E\u5F53\u65F6\u5DF2\u7ECF\u8D8B\u4E8E\u6210\u719F\u751F\u4EA7\u51FA\u5927\u6279\u4EA7\u54C1\u5DE5\u827A\u79E6\u6C49\u59CB\u6709\u4E4B\u5728\u4E1C\u664B\u65F6\u671F\u5DF2\u7ECF\u6709\u67D3\u7F2C\u8272\u6CD5\u7684\u660E\u786E\u8BB0\u8F7D\u8FD9\u4E00\u65F6\u671F\u9EC4\u6CB3\u6D41\u57DF\u662F\u4E3B\u8981\u53D1\u7965\u5730\u4F20\u64AD\u4E2D\u5FC3\u5176\u6280\u672F\u539F\u7406\u57FA\u672C\u5F62\u6210\u4E3B\u8981\u901A\u8FC7\u7EBF\u7EF3\u6346\u624E\u5E03\u6599\u5C40\u90E8\u9632\u6B62\u5176\u5728\u67D3\u8272\u8FC7\u7A0B\u4E2D\u5747\u5300\u7740\u8272\u4ECE\u800C\u5F62\u6210\u72EC\u7279\u82B1\u7EB9\u53E4\u4EE3\u88AB\u79F0\u4E3A\u64AE\u6655\u7F2C\u662F\u901A\u8FC7\u7F1D\u624E\u6346\u7ED3\u7B49\u624B\u5DE5\u9632\u67D3\u6280\u6CD5\u5F62\u6210\u72EC\u7279\u8272\u6655\u7EB9\u6837\u4F20\u7EDF\u8FD9\u79CD\u5728\u9B4F\u664B\u5357\u5317\u671D\u65F6\u671F\u5DF2\u7ECF\u6BD4\u8F83\u6210\u719F\u7279\u522B\u662F\u5728\u5317\u9B4F\u65F6\u671F\u90FD\u57CE\u6D1B\u9633\u5973\u5B50\u4EEC\u5BF9\u60C5\u6709\u72EC\u949F\u5F88\u559C\u6B22\u7A7F\u5E03\u6599\u505A\u8863\u88F3\u8003\u53E4\u5B66\u5BB6\u5728\u65B0\u7586\u5730\u533A\u53D1\u73B0\u6587\u7269\u4E2D\u51FA\u571F\u4E86\u65E9\u671F\u5236\u54C1\u4ECE\u5B9E\u7269\u89D2\u5EA6\u8BC1\u5B9E\u4E86\u5728\u9B4F\u664B\u5357\u5317\u671D\u65F6\u671F\u7684\u5B58\u5728\u4E0E\u4F20\u64AD\u5F53\u65F6\u4EA7\u54C1\u5DF2\u6709\u8F83\u7B80\u5355\u5C0F\u7C07\u82B1\u6837\u5982\u8774\u8776\u814A\u6885\u6D77\u68E0\u7B49\u4E5F\u6709\u6574\u5E45\u56FE\u6848\u82B1\u6837\u5982\u767D\u8272\u5C0F\u5706\u70B9\u9C7C\u5B50\u7F2C\u5706\u70B9\u7A0D\u5927\u739B\u7459\u7F2C\u5510\u5B8B\u65F6\u671F\u5174\u76DB\u4F20\u64AD\u968B\u5510\u5B8B\u4EE3\u8868\u5510\u4EE3\u662F\u53D1\u5C55\u9F0E\u76DB\u65F6\u671F\u65E0\u8BBA\u624E\u82B1\u5DE5\u827A\u67D3\u8272\u6280\u672F\u67D3\u6599\u5236\u4F5C\u8FD8\u662F\u6D41\u4F20\u5730\u57DF\u90FD\u8FBE\u5230\u4E86\u524D\u6240\u672A\u6709\u7684\u6C34\u5E73\u5728\u8FD9\u4E00\u65F6\u671F\u6280\u672F\u4E0E\u4E2D\u539F\u6587\u5316\u4E00\u540C\u4F20\u64AD\u81F3\u897F\u5357\u8FB9\u9672\u5927\u7406\u5730\u533A\u5E76\u88AB\u5F53\u5730\u767D\u65CF\u5148\u6C11\u6240\u63A5\u53D7\u548C\u5438\u6536\u636E\u53F2\u4E66\u8BB0\u8F7D\u4E1C\u6C49\u65F6\u671F\u5927\u7406\u5730\u533A\u5C31\u5DF2\u7ECF\u6709\u67D3\u7EC7\u4E4B\u6CD5\u800C\u5230\u4E86\u5510\u4EE3\u5728\u767D\u65CF\u5730\u533A\u5DF2\u6210\u4E3A\u6C11\u95F4\u65F6\u5C1A\u5236\u54C1\u66F4\u6210\u4E3A\u5411\u7687\u5BAB\u8FDB\u732E\u8D21\u54C1\u7E41\u8363\u666F\u8C61\u5728\u6587\u5316\u827A\u672F\u4F5C\u54C1\u4E2D\u4E5F\u6709\u4F53\u73B0\u6839\u636E\u5510\u4EE3\u5357\u8BCF\u4E2D\u5174\u56FD\u53F2\u753B\u5377\u548C\u5B8B\u4EE3\u5927\u7406\u56FD\u5F20\u80DC\u6E29\u753B\u5377\u4E2D\u4EBA\u7269\u670D\u9970\u7814\u7A76\u8BC1\u660E\u65E9\u5728\u4E00\u5343\u591A\u5E74\u524D\u767D\u65CF\u5148\u6C11\u4FBF\u5DF2\u7ECF\u638C\u63E1\u4E86\u5370\u67D3\u6280\u672F\u5510\u8D1E\u5143\u5341\u516D\u5E74\u516C\u5143\u5E74\u5357\u8BCF\u821E\u961F\u5230\u957F\u5B89\u732E\u827A\u6240\u7740\u821E\u8863\u88D9\u8966\u9E1F\u517D\u8349\u6728\u6587\u4EE5\u516B\u5F69\u6742\u9769\u5373\u4E3A\u800C\u6210\u8FD9\u4E00\u5386\u53F2\u4E8B\u4EF6\u4E0D\u4EC5\u8BC1\u660E\u4E86\u5728\u5357\u8BCF\u5730\u533A\u7684\u6210\u719F\u4E5F\u5C55\u73B0\u4E86\u5F53\u65F6\u670D\u9970\u534E\u4E3D\u4E0E\u7CBE\u7F8E\u5728\u8FD8\u901A\u8FC7\u4E1D\u7EF8\u4E4B\u8DEF\u4F20\u64AD\u81F3\u6D77\u5916\u65E5\u672C\u4E1C\u5927\u5BFA\u5185\u81F3\u4ECA\u5C1A\u5B58\u6709\u5510\u4EE3\u4E94\u5F69\u7EDE\u7F2C\u88AB\u65E5\u672C\u89C6\u4E3A\u56FD\u5B9D\u6709\u610F\u601D\u7684\u662F\u6709\u4E00\u79CD\u8BF4\u6CD5\u8BA4\u4E3A\u5DE5\u827A\u540E\u6765\u7ECF\u65E5\u672C\u53C8\u4F20\u5165\u6211\u56FD\u4E91\u5357\u8FDB\u4E00\u6B65\u4E30\u5BCC\u4E86\u827A\u672F\u8868\u73B0\u5F62\u5F0F\u8FDB\u5165\u5B8B\u4EE3\u7EE7\u7EED\u5728\u4E2D\u539F\u548C\u4E91\u5357\u5730\u533A\u5E76\u884C\u53D1\u5C55\u5317\u5B8B\u5E74\u95F4\u4E2D\u5DDE\u76DB\u884C\u4F5C\u574A\u904D\u5E03\u4E2D\u539F\u5404\u5730\u7136\u800C\u7531\u4E8E\u5B8B\u4EE3\u653F\u7B56\u5BF9\u67D0\u4E9B\u8C6A\u534E\u5DE5\u827A\u9650\u5236\u5728\u4E2D\u539F\u5730\u533A\u5F71\u54CD\u529B\u6709\u6240\u51CF\u5F31\u4E3B\u8981\u7559\u5B58\u4E8E\u6C11\u95F4\u4F5C\u574A\u5728\u67D3\u6599\u4F7F\u7528\u65B9\u9762\u5448\u73B0\u51FA\u9C9C\u660E\u65F6\u4EE3\u7279\u8272\u6C11\u95F4\u6240\u7528\u5E03\u6599\u591A\u7528\u767D\u68C9\u5E03\u8D35\u65CF\u5219\u7528\u539F\u8272\u4E1D\u7EF8\u67D3\u8272\u591A\u91C7\u7528\u690D\u7269\u67D3\u6599\u5982\u7EA2\u82B1\u7D2B\u8349\u5BE5\u84DD\u677F\u5170\u6839\u7B49\u690D\u7269\u7684\u6C41\u6DB2\u6545\u540D\u8349\u6728\u67D3\u8FD9\u6837\u67D3\u51FA\u6765\u6599\u5B50\u989C\u8272\u81EA\u7136\u4E0D\u4F24\u76AE\u80A4\u8FD9\u79CD\u73AF\u4FDD\u5065\u5EB7\u67D3\u8272\u65B9\u6CD5\u4E3A\u540E\u4E16\u6240\u7EE7\u627F\u5E76\u53D1\u5C55\u5143\u660E\u6E05\u65F6\u671F\u6F14\u53D8\u5730\u65B9\u5316\u5143\u4EE3\u6E05\u4EE3\u5143\u660E\u6E05\u65F6\u671F\u5728\u4E2D\u539F\u5730\u533A\u9010\u6E10\u5F0F\u5FAE\u5374\u5728\u4E91\u5357\u5927\u7406\u767D\u65CF\u5730\u533A\u5F97\u4EE5\u4FDD\u5B58\u5E76\u84EC\u52C3\u53D1\u5C55\u8FD9\u4E00\u65F6\u671F\u6D31\u6D77\u767D\u65CF\u5730\u533A\u67D3\u7EC7\u6280\u827A\u5DF2\u8FBE\u5230\u5F88\u9AD8\u6C34\u5E73\u51FA\u73B0\u4E86\u4E13\u4E1A\u67D3\u5E03\u884C\u4F1A\u660E\u671D\u6D31\u6D77\u536B\u7EA2\u5E03\u6E05\u4EE3\u559C\u6D32\u5E03\u548C\u5927\u7406\u5E03\u5747\u662F\u540D\u566A\u4E00\u65F6\u7545\u9500\u4EA7\u54C1\u663E\u793A\u51FA\u5DF2\u7ECF\u5F62\u6210\u72EC\u7279\u5730\u65B9\u7279\u8272\u5E76\u83B7\u5F97\u4E86\u5E7F\u6CDB\u8BA4\u53EF\u660E\u4EE3\u53D1\u5C55\u660E\u4EE3\u5927\u7406\u5730\u533A\u7EBA\u7EC7\u5370\u67D3\u4E1A\u7EE7\u7EED\u53D1\u5C55\u5F62\u6210\u4E86\u4E13\u4E1A\u5316\u67D3\u5E03\u884C\u4F1A\u6807\u5FD7\u7740\u751F\u4EA7\u5DF2\u7ECF\u4ECE\u5C0F\u89C4\u6A21\u5BB6\u5EAD\u624B\u5DE5\u4E1A\u5411\u89C4\u6A21\u5316\u7EC4\u7EC7\u5316\u751F\u4EA7\u8F6C\u53D8\u8FD9\u4E00\u65F6\u671F\u751F\u4EA7\u6D31\u6D77\u536B\u7EA2\u5E03\u5728\u5F53\u65F6\u4EAB\u6709\u76DB\u8A89\u4E0D\u4EC5\u7545\u9500\u672C\u5730\u8FD8\u8FDC\u9500\u5916\u5730\u6E05\u4EE3\u7E41\u8363\u6E05\u4EE3\u5927\u7406\u5730\u533A\u4E1A\u8FDB\u4E00\u6B65\u7E41\u8363\u559C\u6D32\u5E03\u548C\u5927\u7406\u5E03\u6210\u4E3A\u540D\u566A\u4E00\u65F6\u7545\u9500\u4EA7\u54C1\u7279\u522B\u662F\u5927\u7406\u767D\u65CF\u805A\u5C45\u5468\u57CE\u6751\u5728\u8FD9\u4E00\u65F6\u671F\u9010\u6E10\u53D1\u5C55\u6210\u4E3A\u624B\u5DE5\u7EC7\u67D3\u91CD\u8981\u57FA\u5730\u4E3A\u540E\u6765\u6210\u4E3A\u6C11\u65CF\u624E\u67D3\u4E4B\u4E61\u5960\u5B9A\u4E86\u57FA\u7840\u5728\u6280\u827A\u4E0A\u4FDD\u7559\u4E86\u53E4\u4EE3\u7EDE\u7F2C\u6838\u5FC3\u5DE5\u827A\u88AB\u79F0\u4E3A\u53E4\u4EE3\u9632\u67D3\u6CD5\u67D3\u82B1\u5DE5\u827A\u6D3B\u5316\u77F3\u540C\u65F6\u767D\u65CF\u5DE5\u5320\u5728\u957F\u671F\u5B9E\u8DF5\u4E2D\u4E0D\u65AD\u521B\u65B0\u5C06\u672C\u6C11\u65CF\u5BA1\u7F8E\u89C2\u5FF5\u548C\u6587\u5316\u7B26\u53F7\u878D\u5165\u6280\u827A\u4E2D\u4F7F\u4ECE\u5355\u7EAF\u6280\u672F\u4F20\u627F\u5347\u534E\u4E3A\u6C11\u65CF\u6587\u5316\u8868\u8FBE\u65B9\u5F0F\u503C\u5F97\u6CE8\u610F\u7684\u662F\u5728\u8FD9\u4E00\u65F6\u671F\u5F62\u6210\u4E86\u81EA\u5DF1\u72EC\u7279\u5DE5\u827A\u7279\u5F81\u4E3B\u8981\u4EE5\u68C9\u767D\u5E03\u6216\u68C9\u9EBB\u6DF7\u7EBA\u767D\u5E03\u4E3A\u539F\u6599\u67D3\u6599\u5219\u4E3B\u8981\u91C7\u7528\u690D\u7269\u84DD\u975B\u4E91\u5357\u6C11\u95F4\u4FD7\u79F0\u677F\u5170\u6839\u8FD9\u79CD\u4EE5\u84DD\u767D\u4E8C\u8272\u4E3A\u4E3B\u8C03\u914D\u8272\u65B9\u6848\u65E2\u4F53\u73B0\u4E86\u767D\u65CF\u5BF9\u81EA\u7136\u73AF\u5883\u5BA1\u7F8E\u7406\u89E3\u4E5F\u53CD\u6620\u4E86\u4ED6\u4EEC\u5BF9\u6750\u6599\u5929\u7136\u5C5E\u6027\u5C0A\u91CD\u4E0E\u5229\u7528\u8FD1\u73B0\u4EE3\u4FDD\u62A4\u4F20\u627F\u8FD1\u4EE3\u73B0\u4EE3\u8FD1\u4EE3\u4EE5\u6765\u5927\u7406\u67D3\u7EC7\u4E1A\u7EE7\u7EED\u53D1\u5C55\u5468\u57CE\u6210\u4E3A\u8FDC\u8FD1\u95FB\u540D\u624B\u5DE5\u7EC7\u67D3\u6751\u4E16\u7EAA\u5E74\u4EE3\u968F\u7740\u6539\u9769\u5F00\u653E\u6B65\u4F10\u5468\u57CE\u4E8E\u5E74\u5174\u5EFA\u4E86\u5382\u5E26\u52A8\u8FD1\u540D\u5987\u5973\u53C2\u52A0\u624E\u82B1\u5176\u4EA7\u54C1\u4EE5\u4E0A\u9500\u5F80\u65E5\u82F1\u7F8E\u52A0\u62FF\u5927\u7B49\u591A\u4E2A\u56FD\u5BB6\u548C\u5730\u533A\u4F9B\u4E0D\u5E94\u6C42\u5728\u5468\u57CE\u5987\u5973\u4EEC\u51E0\u4E4E\u4E2A\u4E2A\u4F1A\u624E\u82B1\u6237\u6237\u5728\u67D3\u5E03\u5F62\u6210\u4E86\u5BB6\u5BB6\u6709\u67D3\u7F38\u6237\u6237\u51FA\u58EE\u89C2\u666F\u8C61\u8FD9\u4E00\u65F6\u671F\u5927\u7406\u767D\u65CF\u5728\u56FE\u6848\u827A\u672F\u53E4\u4EE3\u7ED3\u624E\u6280\u6CD5\u548C\u73B0\u4EE3\u5370\u67D3\u5DE5\u827A\u76F8\u7ED3\u5408\u57FA\u7840\u4E0A\u63A8\u9648\u51FA\u65B0\u53D1\u5C55\u4E86\u5F69\u8272\u8FD9\u79CD\u65B0\u624B\u5DE5\u5370\u67D3\u6280\u672F\u5F69\u8272\u7A81\u7834\u4E86\u4F20\u7EDF\u5355\u8272\u8C03\u5C40\u9650\u5F3A\u8C03\u591A\u8272\u914D\u5408\u548C\u8272\u5F69\u7EDF\u4E00\u5229\u7528\u624E\u7F1D\u65F6\u5BBD\u7A84\u677E\u7D27\u758F\u5BC6\u5DEE\u5F02\u9020\u6210\u67D3\u8272\u6DF1\u6D45\u4E0D\u4E00\u5F62\u6210\u4E0D\u540C\u7EB9\u6837\u827A\u672F\u6548\u679C\u5E74\u6708\u65E5\u6280\u827A\u7ECF\u56FD\u52A1\u9662\u6279\u51C6\u5217\u5165\u7B2C\u4E00\u6279\u56FD\u5BB6\u7EA7\u975E\u7269\u8D28\u6587\u5316\u9057\u4EA7\u540D\u5F55\u6807\u5FD7\u7740\u8FD9\u4E00\u53E4\u8001\u6280\u827A\u6B63\u5F0F\u7EB3\u5165\u56FD\u5BB6\u5C42\u9762\u4FDD\u62A4\u4F53\u7CFB\u4E0E\u6B64\u540C\u65F6\u5927\u7406\u5E02\u975E\u7269\u8D28\u6587\u5316\u9057\u4EA7\u4FDD\u62A4\u7BA1\u7406\u6240\u88AB\u786E\u5B9A\u4E3A\u9879\u76EE\u4FDD\u62A4\u5355\u4F4D\u5728\u4F20\u627F\u4EBA\u4FDD\u62A4\u65B9\u9762\u5F20\u4ED5\u7EC5\u51FA\u751F\u4E8E\u5E74\u6708\u65E5\u4E8E\u5E74\u6708\u5165\u9009\u4E3A\u7B2C\u4E00\u6279\u56FD\u5BB6\u7EA7\u975E\u7269\u8D28\u6587\u5316\u9057\u4EA7\u9879\u76EE\u4EE3\u8868\u6027\u4F20\u627F\u4EBA\u6BB5\u94F6\u5F00\u51FA\u751F\u4E8E\u5E74\u4E8E\u5E74\u6708\u5165\u9009\u4E3A\u7B2C\u4E94\u6279\u56FD\u5BB6\u7EA7\u975E\u7269\u8D28\u6587\u5316\u9057\u4EA7\u9879\u76EE\u4EE3\u8868\u6027\u4F20\u627F\u4EBA\u8FD9\u4E9B\u4F20\u627F\u4EBA\u901A\u8FC7\u6536\u5F92\u6388\u827A\u521B\u65B0\u5B9E\u8DF5\u7B49\u65B9\u5F0F\u4E3A\u4F20\u627F\u6CE8\u5165\u4E86\u65B0\u6D3B\u529B\u5E74\u56FD\u5BB6\u7EA7\u767D\u65CF\u749E\u771F\u6280\u827A\u4EE3\u8868\u6027\u4F20\u627F\u4EBA\u6BB5\u94F6\u5F00\u591A\u65B9\u7B79\u96C6\u8D44\u91D1\u8FD1\u4E07\u5143\u4FEE\u5EFA\u4E86\u4EE5\u767D\u65CF\u6C11\u5C45\u4E09\u574A\u4E00\u7167\u58C1\u56DB\u5408\u4E94\u5929\u4E95\u4E3A\u57FA\u672C\u5EFA\u7B51\u5F62\u5F0F\u535A\u7269\u9986\u6536\u96C6\u6574\u7406\u51E0\u7ECF\u5931\u4F20\u4F20\u7EDF\u56FE\u6837\u591A\u5F20\u6A21\u677F\u591A\u5757\u4F20\u7EDF\u54C1\u4F59\u4EF6\u5E74\u6708\u65E5\u6587\u5316\u548C\u65C5\u6E38\u90E8\u516C\u5E03\u5E74\u56FD\u5BB6\u7EA7\u975E\u7269\u8D28\u6587\u5316\u9057\u4EA7\u751F\u4EA7\u6027\u4FDD\u62A4\u793A\u8303\u57FA\u5730\u540D\u5355\u4F5C\u4E3A\u9879\u76EE\u4F9D\u6258\u5355\u4F4D\u5927\u7406\u5E02\u749E\u771F\u767D\u65CF\u624E\u67D3\u6709\u9650\u516C\u53F8\u88AB\u8BA4\u5B9A\u4E3A\u5E74\u56FD\u5BB6\u7EA7\u975E\u7269\u8D28\u6587\u5316\u9057\u4EA7\u751F\u4EA7\u6027\u4FDD\u62A4\u793A\u8303\u57FA\u5730\u5728\u73B0\u4EE3\u793E\u4F1A\u4E0D\u65AD\u878D\u5408\u521B\u65B0\u5C55\u73B0\u51FA\u5F3A\u5927\u751F\u547D\u529B\u4E00\u4E9B\u767D\u65CF\u5730\u533A\u53D1\u5C55\u51FA\u4E86\u79F0\u4E3A\u53CD\u6734\u6CD5\u4EFF\u5DE5\u827A\u5236\u54C1\u8FD9\u79CD\u5DE5\u827A\u5728\u53E4\u4EE3\u57FA\u7840\u4E0A\u53D1\u5C55\u8D77\u6765\u50CF\u800C\u975E\u50CF\u6CFC\u753B\u800C\u975E\u6CFC\u753B\u56FE\u6848\u82B1\u7EB9\u517C\u6709\u4E0E\u6CFC\u753B\u4E4B\u98CE\u683C\u5176\u7279\u70B9\u662F\u5728\u5DE5\u827A\u4E0A\u7701\u53BB\u4E86\u624E\u7ED3\u8FD9\u4E00\u5DE5\u5E8F\u56FE\u6848\u82B1\u7EB9\u8272\u6655\u5C42\u6B21\u66F4\u4E3A\u4E30\u5BCC\u5448\u73B0\u51FA\u9519\u6742\u878D\u6D51\u6591\u6593\u539A\u91CD\u8272\u5F69\u6548\u679C\u968F\u7740\u5E02\u573A\u9700\u6C42\u6269\u5927\u56FE\u6848\u4E5F\u8D8A\u6765\u8D8A\u590D\u6742\u548C\u591A\u6837\u5316\u5DF2\u6709\u6570\u767E\u79CD\u4E4B\u591A\u800C\u4E14\u5404\u79CD\u5C3A\u5BF8\u5927\u5C0F\u90FD\u6709\u884D\u751F\u51FA\u5305\u624E\u67D3\u5E3D\u8863\u88D9\u7B49\u7433\u7405\u6EE1\u76EE\u5DE5\u827A\u54C1\u8FD9\u4E9B\u4EA7\u54C1\u4E0D\u4EC5\u6DF1\u53D7\u56FD\u5185\u6D88\u8D39\u8005\u559C\u7231\u8FD8\u8D70\u5411\u4E86\u56FD\u9645\u5E02\u573A\u5F20\u7FF0\u654F\u7B49\u65B0\u4E00\u4EE3\u4F20\u627F\u4EBA\u521B\u529E\u84DD\u7EED\u54C1\u724C\u5C1D\u8BD5\u5C06\u4F20\u7EDF\u975E\u9057\u548C\u73B0\u4EE3\u7F8E\u5B66\u7ED3\u5408\u8D77\u6765\u5F00\u53D1\u4E86\u6EC7\u897F\u5317\u690D\u7269\u8272\u5361\u5E76\u7ED3\u5408\u65F6\u5C1A\u548C\u827A\u672F\u8BBE\u8BA1\u8BA9\u4EA7\u54C1\u95E8\u7C7B\u66F4\u4E30\u5BCC\u8D70\u8FDB\u66F4\u591A\u5E74\u8F7B\u4EBA\u4E16\u754C\u5979\u5E26\u7740\u6280\u827A\u4ECE\u82F1\u56FD\u6CF0\u56FD\u5230\u963F\u8054\u914B\u5FB7\u56FD\u82AC\u84DD\u53C2\u52A0\u4E86\u4F59\u573A\u56FD\u9645\u827A\u672F\u5C55\u89C8\u8BA9\u88AB\u4E16\u754C\u770B\u89C1\u66F4\u4EE4\u4EBA\u60CA\u53F9\u7684\u662F\u5E74\u6708\u65E5\u5929\u5BAB\u8BFE\u5802\u7B2C\u4E8C\u8BFE\u6B63\u5F0F\u5F00\u8BB2\u822A\u5929\u5458\u738B\u4E9A\u5E73\u5728\u4E2D\u56FD\u7A7A\u95F4\u7AD9\u8FDB\u884C\u592A\u7A7A\u6388\u8BFE\u65F6\u6F14\u793A\u4E86\u975E\u9057\u6280\u827A\u8FD9\u6807\u5FD7\u7740\u53E4\u8001\u4E0E\u73B0\u4EE3\u79D1\u6280\u76F8\u7ED3\u5408\u767B\u4E0A\u4E86\u592A\u7A7A\u821E\u53F0\u5C55\u73B0\u4E86\u4F20\u7EDF\u5728\u65B0\u65F6\u4EE3\u65E0\u9650\u53EF\u80FD"
