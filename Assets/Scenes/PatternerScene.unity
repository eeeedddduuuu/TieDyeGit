  m_text: "          \u5DE5\u827A\uFF1A\u9488\u7F1D\u4E0E\u5939\u67D3\u7ED3\u5408\u6CD5\u3002\u9009\u53D6\u81EA\u7136\u754C\u4E2D\u5E38\u89C1\u7684\u53F6\u7247\uFF08\u5982\u67F3\u53F6\u3001\u67AB\u53F6\uFF09\u4F5C\u4E3A\u539F\u578B\uFF0C\u5C06\u5E03\u6599\u5BF9\u6298\u540E\uFF0C\u7528\u9488\u7EBF\u6CBF\u53F6\u7247\u8F6E\u5ED3\u7F1D\u5236\uFF0C\u62BD\u7D27\u624E\u7ED3\uFF0C\u6216\u7528\u53F6\u7247\u5F62\u72B6\u7684\u5939\u5177\u5939\u4F4F\u5E03\u6599\uFF0C\u8FDB\u884C\u5C40\u90E8\u67D3\u8272\uFF0C\u67D3\u8272\u540E\u89E3\u5F00\uFF0C\u5448\u73B0\u51FA\u53F6\u7247\u7684\u81EA\u7136\u5F62\u6001\u3002\n         
    \u5BD3\u610F\uFF1A\u53F6\u7EB9\u8C61\u5F81\u751F\u673A\u3001\u6210\u957F\u4E0E\u5E0C\u671B\u3002\u53F6\u7247\u662F\u690D\u7269\u751F\u957F\u7684\u8C61\u5F81\uFF0C\u5BD3\u610F\u751F\u547D\u84EC\u52C3\u3001\u4E07\u4E8B\u987A\u9042\u3002\r\n"
