  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "     \u4F20\u7EDF\u624E\u67D3\u662F\u767D\u65CF\u5BB6\u5EAD\u91CD\u8981\u7684\u7ECF\u6D4E\u526F\u4E1A\n1984\u5E74,
    \u5927\u7406\u5468\u57CE\u5EFA\u7ACB\u4E86\u7B2C\u4E00\u5BB6\u624E\u67D3\u5382,
    \u5B9E\u73B0\u4E86\u4EA7\u4E1A\u5316, \u4EA7\u54C1\u8FDC\u9500\u65E5\u672C,\u6B27\u7F8E\u7B49\u5730,
    \u4F7F\u767D\u65CF\u624E\u67D3\u95FB\u540D\u4E16\u754C\r      \n     2006\u5E74,
    \u767D\u65CF\u624E\u67D3\u6280\u827A\u7ECF\u56FD\u52A1\u9662\u6279\u51C6\u5217\u5165\u7B2C\u4E00\u6279\u56FD\u5BB6\u7EA7\u975E\u7269\u8D28\u6587\u5316\u9057\u4EA7\u540D\u5F55.
    \u5EFA\u7ACB\u624E\u67D3\u535A\u7269\u9986, \u6536\u96C6, \u6574\u7406\u4F20\u7EDF\u7EB9\u6837\u4E0E\u6280\u827A\r\n     
    \u65B0\u4E00\u4EE3\u4F20\u627F\u4EBA\u5C06\u4F20\u7EDF\u6280\u827A\u4E0E\u73B0\u4EE3\u8BBE\u8BA1\u76F8\u7ED3\u5408,
    \u5F00\u53D1\u51FA\u5F69\u8272\u624E\u67D3\u7B49\u65B0\u4EA7\u54C1, \u8D70\u5411\u56FD\u9645\u65F6\u5C1A\u821E\u53F0\n    "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: beb208dd58d493442abb7597cc55e3a4, type: 2}
