  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "    \u4E1C\u664B\u65F6\u671F\u5DF2\u6709\u201C\u67D3\u7F2C\u8272\u6CD5\u201D\u7684\u660E\u786E\u8BB0\u8F7D,
    \u5E76\u80FD\u751F\u4EA7\u5927\u6279\u7EDE\u7F2C\u7EF8.\u5317\u9B4F\u65F6\u671F,
    \u624E\u67D3\u670D\u9970\u5728\u90FD\u57CE\u6D1B\u9633\u7B49\u5730\u6210\u4E3A\u5973\u6027\u65F6\u5C1A.\n    
    \u8003\u53E4\u5B66\u5BB6\u5728\u65B0\u7586\u5730\u533A\u53D1\u73B0\u7684\u6587\u7269\u4E2D,
    \u51FA\u571F\u4E86\u65E9\u671F\u7EDE\u7F2C\u5236\u54C1, \u4ECE\u5B9E\u7269\u89D2\u5EA6\u8BC1\u5B9E\u4E86\u624E\u67D3\u5DE5\u827A\u5728\u9B4F\u664B\u5357\u5317\u671D\u65F6\u671F\u7684\u5B58\u5728\u4E0E\u4F20\u64AD.
    \u5F53\u65F6\u7684\u624E\u67D3\u4EA7\u54C1\u5DF2\u6709\u8F83\u7B80\u5355\u7684\u5C0F\u7C07\u82B1\u6837,
    \u5982\u8774\u8776,\u814A\u6885,\u6D77\u68E0\u7B49; \u4E5F\u6709\u6574\u5E45\u56FE\u6848\u82B1\u6837,
    \u5982\u767D\u8272\u5C0F\u5706\u70B9\u7684\u201C\u9C7C\u5B50\u7F2C\u201D\uFF0C\u5706\u70B9\u7A0D\u5927\u7684\u201C\u739B\u7459\u7F2C\u201D."
  m_isRightToLeft: 0
