  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "         \u6D78\u6E7F\u5E03\u6599\uFF1A\u5C06\u624E\u597D\u7684\u201C\u5E03\u7599\u7629\u201D\u653E\u5165\u6E05\u6C34\u4E2D\u5B8C\u5168\u6D78\u6E7F\u3001\u62E7\u5E72\u3002\u8FD9\u6709\u52A9\u4E8E\u5E03\u6599\u8FDB\u5165\u67D3\u7F38\u540E\u80FD\u5747\u5300\u3001\u5FEB\u901F\u5730\u5438\u6536\u67D3\u6DB2\uFF0C\u907F\u514D\u4EA7\u751F\u6C14\u6CE1\u5BFC\u81F4\u67D3\u82B1\u3002\r\n\u9996\u6B21\u5165\u67D3\u5C06\u6E7F\u5E03\u56E2\u8F7B\u8F7B\u3001\u7F13\u6162\u5730\u6D78\u5165\u5DF2\u53D1\u9175\u597D\u7684\u975B\u84DD\u67D3\u7F38\u4E2D\u3002\u4F7F\u5E03\u6599\u5B8C\u5168\u6D78\u6CA1\u3002\r\n       
    \u9996\u6B21\u6D78\u67D3\u65F6\u95F4\u901A\u5E38\u4E3A\_10-30\u5206\u949F\u3002\u671F\u95F4\u9700\u7528\u957F\u68CD\u8F7B\u67D4\u7FFB\u52A8\uFF0C\u786E\u4FDD\u67D3\u6DB2\u6E17\u900F\u5230\u6BCF\u4E00\u4E2A\u7F1D\u9699\uFF0C\u9632\u6B62\u63A5\u89E6\u4E0D\u5747\u3002\r\n\u5230\u65F6\u95F4\u540E\uFF0C\u5C06\u5E03\u56E2\u635E\u51FA\uFF0C\u62E7\u53BB\u591A\u4F59\u67D3\u6DB2\u3002\u5C06\u5E03\u56E2\u60AC\u6302\u6216\u644A\u5F00\u5728\u7A7A\u6C14\u4E2D\uFF1A\u539F\u672C\u9644\u7740\u5728\u5E03\u6599\u4E0A\u7684\u9EC4\u7EFF\u8272\u67D3\u6DB2\uFF0C\u4E00\u65E6\u63A5\u89E6\u7A7A\u6C14\u4E2D\u7684\u6C27\u6C14\uFF0C\u4FBF\u5F00\u59CB\u8FC5\u901F\u6C27\u5316\uFF0C\u989C\u8272\u4EE5\u8089\u773C\u53EF\u89C1\u7684\u901F\u5EA6\u7531\u9EC4\u7EFF\u53D8\u4E3A\u6D45\u7EFF\uFF0C\u518D\u53D8\u4E3A\u84DD\u8272\u3002\u8FD9\u4E2A\u8FC7\u7A0B\u4F1A\u5192\u8D77\u7EC6\u5C0F\u7684\u6CE1\u6CAB\uFF0C\u5E76\u53EF\u80FD\u4F34\u6709\u6DE1\u6DE1\u7684\u7279\u6B8A\u6C14\u5473\u3002\u5FC5\u987B\u8BA9\u5E03\u6599\u5145\u5206\u6C27\u5316\uFF0C\u989C\u8272\u7A33\u5B9A\u4E0D\u518D\u53D8\u5316\uFF08\u7EA6\u970015-30\u5206\u949F\uFF09\uFF0C\u624D\u80FD\u8FDB\u884C\u4E0B\u4E00\u6B21\u6D78\u67D3\u3002\r\n      
    \u4E3A\u4E86\u83B7\u5F97\u66F4\u6DF1\u7684\u975B\u84DD\u8272\uFF0C\u9700\u8981\u91CD\u590D\u201C\u6D78\u6CE1-\u6C27\u5316\u201D\u7684\u5FAA\u73AF\u3002\u6BCF\u6B21\u6D78\u6CE1\u540E\uFF0C\u989C\u8272\u90FD\u4F1A\u52A0\u6DF1\u4E00\u5C42\u3002\r\n      
    \u6BCF\u6B21\u6D78\u67D3\u540E\uFF0C\u5E03\u6599\u4E0A\u88AB\u6346\u624E\u6700\u7D27\u5BC6\u7684\u5185\u90E8\uFF0C\u53EF\u80FD\u4ECD\u7136\u53EA\u6709\u5C11\u91CF\u67D3\u6599\u6E17\u5165\uFF0C\u800C\u5916\u90E8\u5219\u5C42\u5C42\u52A0\u6DF1\uFF0C\u7531\u6B64\u5F62\u6210\u4E86\u4ECE\u6DF1\u84DD\u5230\u6D45\u84DD\u76F4\u81F3\u7EAF\u767D\u7684\u4E30\u5BCC\u6E10\u53D8\u5C42\u6B21\u3002"
