  m_text: "\u6BCD\u7248\u5236\u4F5C\uFF08\u6A21\u677F\u96D5\u523B\uFF09\r\n1. \u6750\u6599\u51C6\u5907\r\n\u73B0\u4EE3\u5E38\u7528\u900F\u660E\u6216\u534A\u900F\u660E\u7684\u539A\u5851\u6599\u819C\uFF0C\u56E0\u5176\u9632\u6C34\u3001\u4E0D\u6613\u53D8\u5F62\u4E14\u4FBF\u4E8E\u590D\u5236\u3002\r\n2.
