@startuml 扎染项目用例图

left to right direction

actor 玩家 as User

package "主菜单场景" {
    usecase "开始设计" as StartDesign
    usecase "查看历史记录" as ViewHistory
    usecase "查看工艺介绍" as ViewTechnique
    usecase "退出游戏" as ExitGame
}

package "设计场景" {
    usecase "创建图案" as CreatePattern
    usecase "编辑图案" as EditPattern
    usecase "保存设计" as SaveDesign
    usecase "预览3D效果" as Preview3D
}

package "3D预览场景" {
    usecase "查看设计效果" as ViewDesign
    usecase "旋转查看" as RotateView
    usecase "放大缩小" as ZoomView
    usecase "返回设计" as BackToDesign
}

package "历史记录场景" {
    usecase "浏览历史设计" as BrowseHistory
    usecase "删除历史记录" as DeleteHistory
    usecase "重新编辑" as ReEdit
}

package "工艺介绍场景" {
    usecase "浏览工艺步骤" as BrowseTechnique
    usecase "查看工艺详情" as ViewTechniqueDetail
    usecase "返回主菜单" as BackToMain
}

User --> StartDesign
User --> ViewHistory
User --> ViewTechnique
User --> ExitGame

User --> CreatePattern
User --> EditPattern
User --> SaveDesign
User --> Preview3D

User --> ViewDesign
User --> RotateView
User --> ZoomView
User --> BackToDesign

User --> BrowseHistory
User --> DeleteHistory
User --> ReEdit

User --> BrowseTechnique
User --> ViewTechniqueDetail
User --> BackToMain

StartDesign --> CreatePattern
ViewHistory --> BrowseHistory
ViewTechnique --> BrowseTechnique

Preview3D --> ViewDesign
BackToDesign --> EditPattern
ReEdit --> EditPattern
BackToMain --> StartDesign

@enduml