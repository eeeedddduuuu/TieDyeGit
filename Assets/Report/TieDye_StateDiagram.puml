@startuml 扎染项目状态图

left to right direction

skinparam state {
    backgroundColor #F0F8FF
    borderColor #333333
    arrowColor #666666
    horizontalLineColor #666666
    verticalLineColor #666666
}

skinparam stateMachine {
    arrowColor #666666
}

' 游戏主状态
state "游戏初始化" as GameInitialization
state "主菜单场景" as MainMenu
state "设计场景" as DesignScene
state "3D预览场景" as Preview3D
state "历史记录场景" as HistoryScene
state "工艺介绍场景" as TechniqueScene
state "游戏结束" as GameExit

' 场景过渡状态
state "场景过渡" as SceneTransition {
    state "待机" as Idle
    state "过渡动画(Out)" as TransitionOut
    state "加载新场景" as LoadingScene
    state "过渡动画(In)" as TransitionIn
}

' 设计场景子状态
state "设计场景" {
    state "创建新设计" as NewDesign
    state "编辑现有设计" as EditExistingDesign
    state "保存设计" as SaveDesign
}

' 3D预览场景子状态
state "3D预览场景" {
    state "查看设计效果" as ViewDesign
    state "旋转模型" as RotateModel
    state "缩放模型" as ZoomModel
}

' 历史记录场景子状态
state "历史记录场景" {
    state "浏览历史" as BrowseHistory
    state "删除记录" as DeleteRecord
    state "重新编辑" as ReEditDesign
}

' 工艺介绍场景子状态
state "工艺介绍场景" {
    state "浏览工艺列表" as BrowseTechnique
    state "查看工艺详情" as ViewTechniqueDetail
}

' 初始状态转换
[*] --> GameInitialization
GameInitialization --> MainMenu

' 主菜单状态转换
MainMenu --> SceneTransition : 开始设计
MainMenu --> SceneTransition : 查看历史记录
MainMenu --> SceneTransition : 查看工艺介绍
MainMenu --> GameExit : 退出游戏

' 场景过渡内部状态转换
Idle --> TransitionOut : 触发场景过渡
TransitionOut --> LoadingScene : 过渡动画完成
LoadingScene --> TransitionIn : 场景加载完成
TransitionIn --> Idle : 过渡动画完成

' 场景转换路径
SceneTransition --> DesignScene : 过渡到设计场景
SceneTransition --> Preview3D : 过渡到3D预览场景
SceneTransition --> HistoryScene : 过渡到历史记录场景
SceneTransition --> TechniqueScene : 过渡到工艺介绍场景
SceneTransition --> MainMenu : 返回主菜单

' 设计场景内部转换
DesignScene --> NewDesign : 创建新设计
DesignScene --> EditExistingDesign : 编辑现有设计
NewDesign --> SaveDesign : 保存设计
EditExistingDesign --> SaveDesign : 保存设计
SaveDesign --> DesignScene : 保存完成

' 设计场景到其他场景的转换
DesignScene --> SceneTransition : 预览3D效果
DesignScene --> SceneTransition : 返回主菜单

' 3D预览场景内部转换
Preview3D --> ViewDesign : 查看设计
ViewDesign --> RotateModel : 旋转模型
ViewDesign --> ZoomModel : 缩放模型
RotateModel --> ViewDesign : 停止旋转
ZoomModel --> ViewDesign : 停止缩放

' 3D预览场景到其他场景的转换
Preview3D --> SceneTransition : 返回设计
Preview3D --> SceneTransition : 返回主菜单

' 历史记录场景内部转换
HistoryScene --> BrowseHistory : 浏览历史
BrowseHistory --> DeleteRecord : 删除记录
BrowseHistory --> ReEditDesign : 重新编辑
DeleteRecord --> BrowseHistory : 删除完成
ReEditDesign --> BrowseHistory : 编辑完成

' 历史记录场景到其他场景的转换
HistoryScene --> SceneTransition : 返回主菜单

' 工艺介绍场景内部转换
TechniqueScene --> BrowseTechnique : 浏览工艺
BrowseTechnique --> ViewTechniqueDetail : 查看详情
ViewTechniqueDetail --> BrowseTechnique : 返回列表

' 工艺介绍场景到其他场景的转换
TechniqueScene --> SceneTransition : 返回主菜单

' 游戏结束
GameExit --> [*]

' 过渡类型标注
note right of TransitionOut: 过渡类型：
note right of TransitionOut: - Fade
note right of TransitionOut: - Wipe
note right of TransitionOut: - Slide
note right of TransitionOut: - Zoom
note right of TransitionOut: - TieDyeWipe
note right of TransitionOut: - Dissolve
note right of TransitionOut: - Custom

@enduml